load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "common_lib",
    srcs = glob(
        ["src/*.cc", "src/*.cpp", "src/*.c"], 
        allow_empty = True
    ),
    hdrs = glob(
        ["include/*.h", "include/*.hpp", "include/*.hh"], 
        allow_empty = True
    ),
    includes = ["include"],
    visibility = ["//visibility:public"],
)